<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:uc="using:BitDesk.Views"
            xmlns:vm="using:BitDesk.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:DataType="vm:PairViewModel"
             x:Class="BitDesk.Views.ChartPages.XlmJpyPage">
    <Grid x:Name="ContentArea">
        <uc:ChartContent PairVM="{Binding}" Padding="{DynamicResource PageContentTitleBarSpacingThickness}"/>
    </Grid>
</UserControl>
