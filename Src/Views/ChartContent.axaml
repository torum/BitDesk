<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
            xmlns:vm="using:BitDesk.ViewModels"
            x:DataType="vm:PairViewModel"
             x:Class="BitDesk.Views.ChartContent">
                <Grid>
                    <lvc:CartesianChart x:Name="LiveChart" Margin="0,0,0,0" Background="Transparent"
                                    XAxes="{Binding XAxes, Mode=OneWay}" 
                                    YAxes="{Binding YAxes, Mode=OneWay}" 
                                    Series="{Binding Series, Mode=OneWay}" 
                                        Sections="{Binding Sections, Mode=OneWay}"
                                    TooltipPosition="{Binding IsChartTooltipVisibleTemp, Mode=OneWay}"
                                    ZoomMode="X">
                    </lvc:CartesianChart>
                </Grid>
</UserControl>
