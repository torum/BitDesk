								</PathIcon>
							</Viewbox>	
						</Button>
                        <ListBox Grid.Row="1" ItemsSource="{Binding TradeHistories, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mod:Trade">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Pair, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Tag="{Binding Side, Mode=OneWay}" Text="{Binding SideText, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Amount, Mode=OneWay}" />
                                        <TextBlock Grid.Column="3" Text="{Binding TypeText, Mode=OneWay}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Price, Mode=OneWay}" />
                                        <TextBlock Grid.Column="5" Text="{Binding FeeAmountQuote, Mode=OneWay}" />
                                        <TextBlock Grid.Column="6" Text="{Binding FeeOccurredAmountQuote, Mode=OneWay}" />
                                        <TextBlock Grid.Column="7" Text="{Binding MakerTaker, Mode=OneWay}" />
                                        <TextBlock Grid.Column="8" Text="{Binding OrderID, Mode=OneWay}" />
                                        <TextBlock Grid.Column="9" Text="{Binding TradeID, Mode=OneWay}" />
                                        <TextBlock Grid.Column="10" Text="{Binding ExecutedAtText, Mode=OneWay}" />

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>

        </Grid>

    </Grid>
</UserControl>
