<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:ia="using:Xaml.Behaviors.Interactions.Animated"
             xmlns:vm="using:BitDesk.ViewModels"
             xmlns:mod="using:BitDesk.Models"
             x:DataType="vm:PairViewModel"
             x:Class="BitDesk.Views.ChartContent">
    <Grid>

        <SplitView x:Name="SplitViewControl" Margin="0,0,0,0" CornerRadius="0,0,0,0" BorderThickness="0,0,0,0" PaneBackground="Transparent" IsPaneOpen="{Binding Path=IsPaneOpen, Mode=TwoWay}" PanePlacement="Right" OpenPaneLength="280" CompactPaneLength="0" DisplayMode="CompactInline">
            
            <SplitView.Pane>
                <Grid>
                    <Border Grid.Row="1" BorderThickness="0,0,0,0" Margin="0,48,0,0">
                        <ScrollViewer x:Name="DepthScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" SizeChanged="DepthScrollViewer_SizeChanged">
                              <Interaction.Behaviors>
                                <ia:VerticalScrollViewerAnimatedBehavior/>
                              </Interaction.Behaviors>
                            <ItemsControl x:Name="DepthListBox" ItemsSource="{Binding Path=Depth, Mode=OneWay}" Opacity="0.8" Background="Transparent" Margin="0,0,0,6" Padding="0,12,0,12" HorizontalAlignment="Stretch" DoubleTapped="DepthListBox_DoubleTapped">
                                <ItemsControl.ItemTemplate>
							        <DataTemplate x:DataType="mod:Depth">
                                        <Grid Margin="0" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" x:Name="DepthAskBest" Text="{Binding Path=DepthAskFormatted, Mode=OneWay}" Foreground="{StaticResource PriceUpColorBrush}" FontWeight="Normal" FontSize="12" Margin="2" Padding="0" HorizontalAlignment="Right">

                                            </TextBlock>
                                            <TextBlock Grid.Column="1" x:Name="DepthPrice" Text="{Binding Path=DepthPriceFormatted, Mode=OneWay}" FontWeight="Normal" FontSize="12" Margin="6,2,6,4" Padding="3,0,3,0" HorizontalAlignment="Right">
                                                <Interaction.Behaviors>
											        <DataTriggerBehavior Binding="{Binding IsLTP}" ComparisonCondition="Equal" Value="True">
												        <ChangePropertyAction PropertyName="FontWeight" Value="Bold" />
											        </DataTriggerBehavior>
											        <DataTriggerBehavior Binding="{Binding IsLTP}" ComparisonCondition="Equal" Value="False">
												        <ChangePropertyAction PropertyName="FontWeight" Value="Normal" />
											        </DataTriggerBehavior>
										        </Interaction.Behaviors>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" x:Name="DepthBidBest" Text="{Binding Path=DepthBidFormatted, Mode=OneWay}" Foreground="{StaticResource PriceDownColorBrush}" FontWeight="Normal" FontSize="12" Margin="2" Padding="0" HorizontalAlignment="Right">

                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </SplitView.Pane>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                
                <lvc:CartesianChart x:Name="LiveChart" Grid.Row="0" Margin="0,32,0,0" Background="Transparent"
                                    XAxes="{Binding XAxes, Mode=OneWay}"
                                    YAxes="{Binding YAxes, Mode=OneWay}"
                                    Series="{Binding Series, Mode=OneWay}"
                                    Sections="{Binding Sections, Mode=OneWay}"
                                    TooltipPosition="{Binding IsChartTooltipVisibleTemp, Mode=OneWay}"
                                    ZoomMode="X">
                </lvc:CartesianChart>

                <Border HorizontalAlignment="Left" 
                                        VerticalAlignment="Top" 
                                        Margin="8,10,8,8" 
                                        Padding="8,4" 
                                        CornerRadius="4" 
                                        Background="{DynamicResource AcrylicInAppFillColorDefaultBrush}" 
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,2,4,2">
                            <TextBlock Text="{Binding PairString}" FontWeight="SemiBold" Margin="4" />
                            <TextBlock Text="{Binding LtpString}" FontWeight="SemiBold" Margin="4" />
                            <TextBlock Text="{Binding PercentChange}" FontWeight="Normal" Margin="4" />
                        </StackPanel>

                        <Grid Margin="8,2,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="24H High: " FontSize="12" Opacity="0.7"></TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Path=High24String, Mode=OneWay}" FontSize="12" Opacity="0.7" Margin="6,0,0,0"></TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="24H Low: " FontSize="12" Opacity="0.7"></TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Path=Low24String, Mode=OneWay}" FontSize="12" Opacity="0.7" Margin="6,0,0,0"></TextBlock>
                        </Grid>

                        <StackPanel Margin="4,2,4,2">

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                <SplitButton x:Name="ChartTypeSplitButton" Content="{Binding SelectedCandleTypeLabelString}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" Width="120" Height="24">
					                <SplitButton.Flyout>
						                <MenuFlyout Placement="Bottom">
							                <MenuItem Header="1min" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="OneMin"/>
							                <MenuItem Header="5min" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="FiveMin" />
							                <MenuItem Header="15min" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="FifteenMin" />
							                <MenuItem Header="30min" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="ThirtyMin" />
                                            <Separator/>
							                <MenuItem Header="1hour" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="OneHour" />
							                <MenuItem Header="4hour" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="FourHour" />
							                <MenuItem Header="8hour" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="EightHour" />
							                <MenuItem Header="12hour" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="TwelveHour" />
                                            <Separator/>
							                <MenuItem Header="1day" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="OneDay" />
							                <MenuItem Header="1week" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="OneWeek" />
							                <MenuItem Header="1month" Command="{Binding ChangeCandleTypeFromTagCommand}" CommandParameter="{Binding $self.Tag}" Tag="OneMonth" />
							                <Separator/>
						                </MenuFlyout>
					                </SplitButton.Flyout>
                                </SplitButton>
                                <ToggleButton IsChecked="{Binding IsPaneOpen, Mode=TwoWay}" Height="32" Margin="6,0,0,0">
                                    <PathIcon Width="16" Height="16" Data="M14 5.5C14 4.11929 12.8807 3 11.5 3H4.5C3.11929 3 2 4.11929 2 5.5V10.5C2 11.8807 3.11929 13 4.5 13H11.5C12.8807 13 14 11.8807 14 10.5V5.5ZM9 4V12H4.5C3.67157 12 3 11.3284 3 10.5V5.5C3 4.67157 3.67157 4 4.5 4H9ZM10 4H11.5C12.3284 4 13 4.67157 13 5.5V10.5C13 11.3284 12.3284 12 11.5 12H10V4Z"></PathIcon>
                                </ToggleButton>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="BottomCommandBarStackPanel" Orientation="Horizontal" Grid.Row="0">
                    
                    </StackPanel>
                    <StackPanel x:Name="BottomListViewStackPanel" Orientation="Horizontal" Grid.Row="1">
                    


                    </StackPanel>

                </Grid>
            </Grid>

        </SplitView>

    </Grid>
</UserControl>
