<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BitDesk.Views.LogOnDialog">
	<Grid>
		<StackPanel Margin="10" Width="250">
			<TextBox Name="UserKeyTextBox" PasswordChar="*" Margin="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" PlaceholderText="Enter your key" AttachedToVisualTree="InputField_OnAttachedToVisualTree" />
		</StackPanel>
	</Grid>
</UserControl>
