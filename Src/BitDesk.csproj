<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	  <RootNamespace>BitDesk</RootNamespace>
	  <AssemblyName>BitDesk</AssemblyName>
	  <ApplicationIcon>Assets\BitDesk.ico</ApplicationIcon>

	  <VersionPrefix>2.0.0.0</VersionPrefix>
	  <FileVersion>2.0.0.0</FileVersion>
	  
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\BitDesk.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Services\BitbankRestService.cs" />
    <None Include="Services\Contracts\IBitbankRestService.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	  <PackageReference Include="Egolds.Xaml.Behaviors.Interactions.Animated" Version="11.4.0" />
	  <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
	  <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.1.0-dev-798" />
	  <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
	  <PackageReference Include="SocketIOClient" Version="4.0.5" />
	  <PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.7" />
	  <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\ChartPages\XlmJpyPage.axaml.cs">
      <DependentUpon>XlmJpyPage.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\GridViewPage.axaml.cs">
      <DependentUpon>GridViewPage.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
